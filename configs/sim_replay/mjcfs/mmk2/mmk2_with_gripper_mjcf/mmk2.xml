<mujoco model="mmk2">

  <option integrator="RK4" solver="Newton" />
  <compiler angle="radian" meshdir="meshes" texturedir="meshes"/>

  <default>
    <default class="obj_visual">
      <geom group="2" type="mesh" contype="0" conaffinity="0"/>
    </default>
    <default class="obj_collision">
      <geom group="3" condim="6" solimp="2 1 0.01" solref="0.001 10" friction="1 0.005 0.0001" type="mesh"/>
    </default>

    <default class='arm'>
      <default class='joint1'>
        <joint axis='0 0 1' range="-3.14 2.09" actuatorfrcrange="-24 24" damping="0.2" frictionloss='15' />
        <position ctrlrange="-3.14 2.09"/>
      </default>

      <default class='joint2'>
        <joint axis='0 0 1' range="-2.96 0.17" actuatorfrcrange="-24 24" damping="0.2" frictionloss='15' />
        <position ctrlrange="-2.96 0.17" />
      </default>

      <default class='joint3'>
        <joint axis='0 0 1' range='-0.087 3.14' actuatorfrcrange="-24 24" damping="0.2" frictionloss='15' />
        <position ctrlrange='-0.087 3.14'/>
      </default>

      <default class='joint4'>
        <joint axis='0 0 1' range="-2.96 2.96" actuatorfrcrange="-8 8" damping="0.1" frictionloss='5' />
        <position ctrlrange="-2.96 2.96"/>
      </default>

      <default class='joint5'>
        <joint axis='0 0 1' range="-1.74 1.74" actuatorfrcrange="-8 8" damping="0.1" frictionloss='5' />
        <position ctrlrange="-1.74 1.74"/>
      </default>

      <default class='joint6'>
        <joint axis='0 0 1' range="-3.14 3.14" actuatorfrcrange="-8 8" damping="0.1" frictionloss='5' />
        <position ctrlrange="-3.14 3.14"/>
      </default>

      <default class='finger1'>
        <joint axis='0 1 0' range="-0.04 0" type='slide' damping="0.5" frictionloss="15"/>
      </default>

      <default class='finger2'>
        <joint axis='0 1 0' range="0 0.04" type='slide' damping="0.5" frictionloss="15"/>
      </default>
    </default>

    <default class='slide_joint'>
      <joint range='-0.04 0.87' type='slide' axis='0 0 -1' frictionloss="1000" damping="100" actuatorfrcrange="-1600 1000"/>
      <position ctrlrange='-0.04 0.87' kp='50000'/>
    </default>
    <default class='head_yaw_joint'>
      <joint axis='0 0 1' range='-0.5 0.5'/>
      <position ctrlrange='-0.5 0.5' kp='1' kv='.1'/>
    </default>
    <default class='head_pitch_joint'>
      <joint axis='0 0 -1' range="-1.18 0.16"/>
      <position ctrlrange='-1.18 0.16' kp='100' kv='10'/>
    </default>

    <default class='wheel'>
      <joint axis='0 0 -1' damping='0.5' frictionloss='0.1'/>
      <motor ctrlrange='-35 35' forcerange='-35 35'/>
    </default>

  </default>

  <asset>
    <material name="Paint_Matte_Black" specular="0.5" shininess="0.5" rgba="0.00111266039 0.00111266039 0.00111266039 1.0"/>
    <material name="Paint_Metallic_Cool_Grey" specular="0.5" shininess="0.5" rgba="0.928523183 0.928523183 0.928523123 1.0"/>
    <material name="Gree_Light_Base" specular="0.5" shininess="0.5" rgba="0.6 1 1 1"/>
  </asset>

  <asset>
    <mesh name="arm_base_0" file="airbot_play/arm_base_0.obj"/>
    <mesh name="arm_base_1" file="airbot_play/arm_base_1.obj"/>
