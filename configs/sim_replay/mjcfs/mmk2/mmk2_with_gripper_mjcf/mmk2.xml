    <exclude body1='slide_link' body2='head_pitch_link'/>
    <exclude body1='slide_link' body2='head_yaw_link'/>
    <exclude body1='slide_link' body2='lft_arm_link2'/>
    <exclude body1='slide_link' body2='rgt_arm_link2'/>
